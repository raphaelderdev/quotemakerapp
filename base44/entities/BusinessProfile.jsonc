{
  "name": "BusinessProfile",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "profession": {
      "type": "string"
    },
    "vat_rate": {
      "type": "number",
      "default": 20
    },
    "terms": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    }
  },
  "required": [
    "company_name"
  ]
}