{
  "name": "Quote",
  "type": "object",
  "properties": {
    "quote_number": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "accepted",
        "rejected"
      ],
      "default": "draft"
    },
    "raw_message": {
      "type": "string"
    },
    "profession": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "vat_rate": {
      "type": "number"
    },
    "vat_amount": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "terms": {
      "type": "string"
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    }
  },
  "required": [
    "customer_name",
    "status"
  ]
}